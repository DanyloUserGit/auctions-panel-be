generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SuperAdmin
  Admin
  User
}

enum Rights {
  Read
  Write
  ReadAndWrite
  Buy
  Sell
  BuyAndSell
}

model User {
  id            String         @id @default(uuid()) @db.Uuid()
  firstName     String
  lastName      String
  email         String         @unique
  password      String
  role          String         @default("User")
  rights        String         @default("Read")
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid()
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}
