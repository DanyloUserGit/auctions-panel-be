generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SuperAdmin
  Admin
  User
}

enum Rights {
  Read
  Write
  All
}

enum SessionRights {
  Read
  Buy
  Sell
  All
}

model User {
  id            String         @id @default(uuid()) @db.Uuid()
  firstName     String
  lastName      String
  email         String         @unique
  password      String
  role          Roles          @default(User)
  rights        Rights         @default(Read)
  sessionRights SessionRights  @default(Read)
  refreshTokens RefreshToken[]
  auctions      Auction[]      @relation("UserAuctions")
  session       Session?       @relation(fields: [sessionId], references: [id])
  sessionId     String?        @db.Uuid()
  resetTokens   ResetToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid()
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model AuctionAuth {
  id       String @id @default(uuid()) @db.Uuid()
  email    String
  password String

  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  sessions Session[]

  @@map("auction_auths")
}

model Session {
  id String @id @default(uuid()) @db.Uuid()

  maxConnections    Int
  activeConnections Int
  isActive          Boolean

  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id])

  auctionAuthId String      @db.Uuid
  account       AuctionAuth @relation(fields: [auctionAuthId], references: [id])

  users User[]

  expiresAt DateTime
  createdAt DateTime @default(now())
  worker    Worker?  @relation(fields: [workerId], references: [id])
  workerId  String?  @db.Uuid()

  @@map("sessions")
}

model Auction {
  id                 String              @id @default(uuid()) @db.Uuid()
  title              String
  url                String
  users              User[]              @relation("UserAuctions")
  sessions           Session[]
  auctionAuths       AuctionAuth[]
  auctionGroup       AuctionGroup?       @relation(fields: [auctionGroupId], references: [id])
  auctionGroupId     String?             @db.Uuid()
  allowedRoutes      AllowedRoute[]
  forbiddenSelectors ForbiddenSelector[]

  @@map("auctions")
}

model AuctionGroup {
  id       String    @id @default(uuid()) @db.Uuid()
  title    String
  auctions Auction[]

  @@map("auction_groups")
}

model AllowedRoute {
  id        String  @id @default(uuid()) @db.Uuid()
  path      String
  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id])

  @@map("allowed_routes")
}

model ForbiddenSelector {
  id        String  @id @default(uuid()) @db.Uuid()
  selector  String
  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id])

  @@map("forbidden_selectors")
}

model Worker {
  id       String    @id @default(uuid()) @db.Uuid()
  host     String
  port     Int
  isActive Boolean
  sessions Session[]
}

model ResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
