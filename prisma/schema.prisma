generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SuperAdmin
  Admin
  User
}

enum Rights {
  Read
  Write
  All
}

enum SessionRights {
  Read
  Buy
  Sell
  All
}

enum NotificationChannel {
  InApp
  Email
  Telegram
  Viber
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid()
  firstName                String
  lastName                 String
  email                    String                    @unique
  password                 String
  phone                    String?
  city                     String?
  role                     Roles                     @default(User)
  rights                   Rights                    @default(Read)
  sessionRights            SessionRights             @default(Read)
  isActive                 Boolean                   @default(true)
  isBlocked                Boolean                   @default(false)
  sessionLimit             Int                       @default(1)
  lastLogin                DateTime?
  lastActivity             DateTime?
  refreshTokens            RefreshToken[]
  auctions                 Auction[]                 @relation("UserAuctions")
  session                  Session?                  @relation(fields: [sessionId], references: [id])
  sessionId                String?                   @db.Uuid()
  resetTokens              ResetToken[]
  auctionGroup             AuctionGroup?             @relation("GroupParticipants", fields: [auctionGroupId], references: [id])
  auctionGroupId           String?                   @db.Uuid()
  managedGroup             AuctionGroup?             @relation("GroupAdministrator")
  userNotificationSettings UserNotificationSetting[]
  notifications            Notification[]

  @@map("users")
}

model NotificationType {
  id          String  @id @default(uuid()) @db.Uuid()
  name        String  @unique
  description String?

  userSettings UserNotificationSetting[]

  groupRequirements GroupNotificationRequirement[]

  @@map("notification_types")
}

model UserNotificationSetting {
  id                 String           @id @default(uuid()) @db.Uuid()
  userId             String           @db.Uuid()
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationTypeId String           @db.Uuid()
  notificationType   NotificationType @relation(fields: [notificationTypeId], references: [id])

  isEnabled Boolean               @default(true)
  channels  NotificationChannel[] @default([InApp])

  @@unique([userId, notificationTypeId])
  @@map("user_notification_settings")
}

model GroupNotificationRequirement {
  id                 String           @id @default(uuid()) @db.Uuid()
  groupId            String           @db.Uuid()
  group              AuctionGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  notificationTypeId String           @db.Uuid()
  notificationType   NotificationType @relation(fields: [notificationTypeId], references: [id])

  isMandatory Boolean @default(false)

  @@unique([groupId, notificationTypeId])
  @@map("group_notification_requirements")
}

model Notification {
  id     String @id @default(uuid()) @db.Uuid()
  userId String @db.Uuid()
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  message String  @db.Text
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid()
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model AuctionAuth {
  id       String @id @default(uuid()) @db.Uuid()
  email    String
  password String

  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  sessions Session[]

  @@map("auction_auths")
}

model Session {
  id String @id @default(uuid()) @db.Uuid()

  maxConnections    Int
  activeConnections Int
  isActive          Boolean

  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id])

  auctionAuthId String      @db.Uuid
  account       AuctionAuth @relation(fields: [auctionAuthId], references: [id])

  users User[]

  expiresAt DateTime
  createdAt DateTime @default(now())
  worker    Worker?  @relation(fields: [workerId], references: [id])
  workerId  String?  @db.Uuid()

  @@map("sessions")
}

model Auction {
  id                 String              @id @default(uuid()) @db.Uuid()
  title              String
  url                String
  users              User[]              @relation("UserAuctions")
  sessions           Session[]
  auctionAuths       AuctionAuth[]
  auctionGroup       AuctionGroup?       @relation(fields: [auctionGroupId], references: [id])
  auctionGroupId     String?             @db.Uuid()
  allowedRoutes      AllowedRoute[]
  forbiddenSelectors ForbiddenSelector[]

  @@map("auctions")
}

model AuctionGroup {
  id       String    @id @default(uuid()) @db.Uuid()
  title    String
  auctions Auction[]

  users User[] @relation("GroupParticipants")

  groupAdminId                  String?                        @unique @db.Uuid()
  groupAdmin                    User?                          @relation("GroupAdministrator", fields: [groupAdminId], references: [id])
  groupNotificationRequirements GroupNotificationRequirement[]

  @@map("auction_groups")
}

model AllowedRoute {
  id        String  @id @default(uuid()) @db.Uuid()
  path      String
  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id])

  @@map("allowed_routes")
}

model ForbiddenSelector {
  id        String  @id @default(uuid()) @db.Uuid()
  selector  String
  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id])

  @@map("forbidden_selectors")
}

model Worker {
  id       String    @id @default(uuid()) @db.Uuid()
  host     String
  port     Int
  isActive Boolean
  sessions Session[]
}

model ResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}
