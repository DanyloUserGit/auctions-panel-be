generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SuperAdmin
  Admin
  User
}

enum NotificationConfigType {
  Configurable
  System
}

enum Rights {
  Read
  Write
  All
}

enum SessionRights {
  Read
  Buy
  Sell
  All
}

// Статус доступу користувача (ТЗ 12). «Заблокований» - окремий прапорець User.isBlocked,
// щоб після розблокування повертався попередній статус.
enum AccessStatus {
  ReadOnly // Тільки перегляд
  Purchase // Дозволені покупки
  PurchaseSale // Дозволені покупки + дозволені продажі
  PurchaseNoSales // Дозволені покупки без доступу до продажів
}

enum NotificationChannel {
  InApp
  Email
  Telegram
  Viber
}

enum MaterialVisibility {
  All
  Group
}

enum SessionEventType {
  ForbiddenAction
  Navigation
  SessionError
  TextInput
  ButtonClick
  Other
}

enum SessionEndReason {
  Admin // завершив адміністратор у «Всіх діях»
  Inactivity // таймаут бездіяльності
  NoConnections // від'єдналися всі користувачі
  Error // збій браузера / воркера (статус «помилка»)
}

enum LogSeverity {
  Info
  Warning
  Critical
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid()
  firstName                String
  lastName                 String
  middleName               String?
  email                    String                    @unique
  password                 String
  phone                    String?
  city                     String?
  // Адмін-поля картки контролю (ТЗ 11): бачать і змінюють лише SA та GA своєї групи.
  hasContract              Boolean                   @default(false)
  contractNumber           String?
  depositAmount            Decimal?                  @db.Decimal(12, 2)
  depositMethod            String?
  adminComment             String?                   @db.Text
  adminExtra               String?                   @db.Text
  telegramChatId           String?
  viberId                  String?
  role                     Roles                     @default(User)
  /// Застаріле (замінено accessStatus), не використовується; видалити після перевірки міграції на копії продакшн-бази.
  rights                   Rights                    @default(Read)
  /// Застаріле (замінено accessStatus), не використовується; видалити після перевірки міграції на копії продакшн-бази.
  sessionRights            SessionRights             @default(Read)
  accessStatus             AccessStatus              @default(ReadOnly)
  isActive                 Boolean                   @default(true)
  isBlocked                Boolean                   @default(false)
  // Особистий ліміт одночасних сесій (вкладок) користувача; 0 - без особистого ліміту.
  sessionLimit             Int                       @default(0)
  lastLogin                DateTime?
  lastActivity             DateTime?
  refreshTokens            RefreshToken[]
  sessionConnections       SessionConnection[]
  resetTokens              ResetToken[]
  userGroup                UserGroup?                @relation("GroupParticipants", fields: [userGroupId], references: [id])
  userGroupId              String?                   @db.Uuid()
  managedGroup             UserGroup?                @relation("Administrator")
  userNotificationSettings UserNotificationSetting[]
  notifications            Notification[]
  trainingMaterials        TrainingMaterial[]
  terminatedSessions       Session[]                 @relation("SessionTerminator")
  sessionLogs              SessionLog[]
  selectedAccounts         AuctionAuth[]             @relation("UserSelectedAccounts")
  personalAuctionGroups    AuctionGroup[]            @relation("UserPersonalAuctionGroups")
  personalAuctions         Auction[]                 @relation("UserPersonalAuctions")
  personalAccounts         AuctionAuth[]             @relation("UserPersonalAccounts")
  deniedAccounts           AuctionAuth[]             @relation("UserDeniedAccounts")
  inStockCars              InStockCarOwner[]
  crmClients               CrmClientAssignment[]
  auditActions             AuditLog[]                @relation("AuditActor")
  auditEvents              AuditLog[]                @relation("AuditTarget")
  auctionReminders         AuctionReminder[]
  accessRules              AccessRule[]
  clients                  Client[]

  @@map("users")
}

model InformationPage {
  id        String   @id @default(uuid()) @db.Uuid()
  title     String
  slug      String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("information_pages")
}

model TrainingMaterial {
  id          String  @id @default(uuid()) @db.Uuid()
  title       String
  content     String  @db.Text
  imageUrl    String?
  isPublished Boolean @default(false)

  visibility   MaterialVisibility @default(All)
  allowedRoles Roles[] @default([])

  authorId String @db.Uuid()
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  groupId String?    @db.Uuid()
  group   UserGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("training_materials")
}

model NotificationType {
  id          String  @id @default(uuid()) @db.Uuid()
  name        String  @unique
  description String?

  roles Roles[]

  configType NotificationConfigType @default(Configurable)

  setting Json?

  userSettings      UserNotificationSetting[]
  groupRequirements GroupNotificationRequirement[]
}

model UserNotificationSetting {
  id                 String                @id @default(uuid()) @db.Uuid()
  userId             String                @db.Uuid()
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationTypeId String                @db.Uuid()
  notificationType   NotificationType      @relation(fields: [notificationTypeId], references: [id])
  value              Int
  isEnabled          Boolean               @default(true)
  channels           NotificationChannel[] @default([InApp])

  @@unique([userId, notificationTypeId])
  @@map("user_notification_settings")
}

model GroupNotificationRequirement {
  id                 String           @id @default(uuid()) @db.Uuid()
  groupId            String           @db.Uuid()
  group              UserGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  notificationTypeId String           @db.Uuid()
  notificationType   NotificationType @relation(fields: [notificationTypeId], references: [id])

  isMandatory Boolean @default(false)

  @@unique([groupId, notificationTypeId])
  @@map("group_notification_requirements")
}

model Notification {
  id     String @id @default(uuid()) @db.Uuid()
  userId String @db.Uuid()
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  message String  @db.Text
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid()
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model AuctionAuth {
  id       String @id @default(uuid()) @db.Uuid()
  title    String
  email    String
  password String

  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  sessions Session[]

  allowedForUserGroups UserGroup[] @relation("UserGroupAllowedAccounts")
  allowedForUsers      User[]      @relation("UserPersonalAccounts")
  deniedForUsers       User[]      @relation("UserDeniedAccounts")
  selectedByUsers      User[]      @relation("UserSelectedAccounts")

  @@map("auction_auths")
}

model Session {
  id String @id @default(uuid()) @db.Uuid()

  maxConnections    Int
  activeConnections Int
  isActive          Boolean

  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  auctionAuthId String      @db.Uuid
  account       AuctionAuth @relation(fields: [auctionAuthId], references: [id])

  connections SessionConnection[]
  logs        SessionLog[]
  endedAt     DateTime?
  endedById   String?           @db.Uuid()
  endedBy     User?             @relation("SessionTerminator", fields: [endedById], references: [id])
  endReason   SessionEndReason?
  // Текст помилки для сесій, завершених через збій (статус «помилка»).
  errorMessage String?          @db.Text

  // Остання дія користувача в сесії - для завершення за таймаутом бездіяльності.
  lastActivityAt DateTime      @default(now())
  createdAt      DateTime      @default(now())
  worker         Worker?       @relation(fields: [workerId], references: [id])
  workerId       String?       @db.Uuid()
  auctionGroup   AuctionGroup? @relation(fields: [auctionGroupId], references: [id])
  auctionGroupId String?       @db.Uuid()

  @@map("sessions")
}

// Підключення користувача до сесії (одна вкладка в панелі). Один користувач може бути
// підключений до кількох сесій одночасно, а в сесії - кілька користувачів.
model SessionConnection {
  id             String    @id @default(uuid()) @db.Uuid()
  sessionId      String    @db.Uuid()
  session        Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId         String    @db.Uuid()
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // socket.io id клієнта; за ним воркер тримає окрему сторінку браузера для вкладки.
  clientId       String?
  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?

  @@index([sessionId, disconnectedAt])
  @@index([userId, disconnectedAt])
  @@map("session_connections")
}

model Auction {
  id                 String              @id @default(uuid()) @db.Uuid()
  title              String
  url                String
  // Проксі для сайтів, що блокують IP сервера (ТЗ 20, 22: Alcopa). URL з логіном/паролем - зашифрований,
  // з API не повертається (PrismaService omit); proxyHost - лише для відображення.
  proxyUrl           String?
  proxyHost          String?
  sessions           Session[]
  auctionAuths       AuctionAuth[]
  auctionGroup       AuctionGroup?       @relation(fields: [auctionGroupId], references: [id])
  auctionGroupId     String?             @db.Uuid()
  allowedRoutes      AllowedRoute[]
  forbiddenSelectors ForbiddenSelector[]
  forbiddenRoutes    ForbiddenRoute[]
  allowedForGroups   UserGroup[]         @relation("UserGroupAllowedAuctions")
  allowedForUsers    User[]              @relation("UserPersonalAuctions")
  accessRules        AccessRule[]

  @@map("auctions")
}

model AuctionGroup {
  id    String @id @default(uuid()) @db.Uuid()
  title String

  sessionLimit Int @default(0)

  auctions Auction[]
  sessions Session[]

  allowedForUserGroups UserGroup[] @relation("UserGroupAllowedAuctionGroups")
  allowedForUsers      User[]      @relation("UserPersonalAuctionGroups")

  @@map("auction_groups")
}

model UserGroup {
  id   String @id @default(uuid()) @db.Uuid()
  name String

  isActive Boolean @default(true)

  canGaManageAccounts Boolean @default(false)
  showAccounts        Boolean @default(true)
  // Ліміт одночасних сесій, до яких підключені учасники групи; 0 - без ліміту.
  sessionLimit        Int     @default(0)
  // Чи може GA задавати правила заборон для своєї групи (ТЗ 8: «якщо дозволено»).
  canGaManageRules    Boolean @default(false)
  accessRules         AccessRule[]
  rules               Json?   @default("{}")

  lastActivity DateTime?

  users                User[]   @relation("GroupParticipants")
  allowedProfileFields String[] @default(["firstName", "lastName", "phone", "city"])

  allowedAuctions Auction[] @relation("UserGroupAllowedAuctions")

  AdminId String? @unique @db.Uuid()
  Admin   User?   @relation("Administrator", fields: [AdminId], references: [id])

  groupNotificationRequirements GroupNotificationRequirement[]
  trainingMaterials             TrainingMaterial[]
  allowedAuctionGroups          AuctionGroup[]                 @relation("UserGroupAllowedAuctionGroups")
  allowedAccounts               AuctionAuth[]                  @relation("UserGroupAllowedAccounts")

  @@map("user_groups")
}

model AllowedRoute {
  id        String  @id @default(uuid()) @db.Uuid()
  path      String
  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@map("allowed_routes")
}

model ForbiddenRoute {
  id        String  @id @default(uuid()) @db.Uuid()
  path      String
  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@map("forbidden_routes")
}

model ForbiddenSelector {
  id        String  @id @default(uuid()) @db.Uuid()
  selector  String
  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  isBuyAction Boolean @default(false)

  @@map("forbidden_selectors")
}

model Worker {
  id       String    @id @default(uuid()) @db.Uuid()
  host     String
  port     Int
  isActive Boolean
  sessions Session[]
}

model ResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SessionLog {
  id        String  @id @default(uuid()) @db.Uuid()
  sessionId String  @db.Uuid()
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid()
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  eventType SessionEventType
  severity  LogSeverity      @default(Info)

  message String @db.Text
  details Json?

  isIncident Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@index([isIncident])
  @@map("session_logs")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid()
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// Власник авто в «В наявності» (ТЗ 13.3). Авто зберігаються в базі замовника (cars_for_sale),
// де немає місця для ID користувача платформи, тому власник - тут.
model InStockCarOwner {
  carId     Int      @id
  ownerId   String   @db.Uuid()
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("in_stock_car_owners")
}

// Прив'язка клієнтів CRM (поле zamovnyk у cars_data / transport_payments) до користувачів платформи
// (ТЗ 13.5, 13.6: User бачить процеси й баланси своїх клієнтів, GA - клієнтів своєї групи, SA - усіх).
model CrmClientAssignment {
  clientName String
  userId     String   @db.Uuid()
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([clientName, userId])
  @@index([userId])
  @@map("crm_client_assignments")
}

enum AuditCategory {
  Auth // входи й виходи (успішні та неуспішні)
  Admin // зміни налаштувань, доступів, користувачів, статусів
}

// Журнал аудиту (ТЗ 4, 9, 12, 18): входи/виходи та дії адміністраторів. Секрети не зберігаються.
model AuditLog {
  id           String        @id @default(uuid()) @db.Uuid()
  category     AuditCategory
  action       String
  message      String        @db.Text
  details      Json?
  actorId      String?       @db.Uuid()
  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId String?       @db.Uuid()
  targetUser   User?         @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  ip           String?
  createdAt    DateTime      @default(now())

  @@index([category, createdAt])
  @@index([actorId])
  @@index([targetUserId])
  @@map("audit_logs")
}

// Нагадування про завершення аукціону (ТЗ 15): єдиний тип сповіщень, який користувач налаштовує сам -
// за скільки часу до завершення нагадати (UserNotificationSetting.value для AUCTION_ENDED, секунди).
model AuctionReminder {
  id        String    @id @default(uuid()) @db.Uuid()
  userId    String    @db.Uuid()
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  url       String?
  endsAt    DateTime
  remindAt  DateTime
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sentAt, remindAt])
  @@map("auction_reminders")
}

enum RuleKind {
  Route // перехід (адреса, шлях або шаблон)
  Selector // елемент (CSS-селектор)
}

enum RuleEffect {
  Forbid
  Allow // виняток: дозволити те, що заборонено на ширшому рівні
}

// Правила контролю дій на рівнях (ТЗ 8): глобально (без групи й користувача), для групи користувачів,
// для окремого користувача. Пріоритет: користувач > група > глобальні правила та правила аукціону.
// auctionId порожній - правило діє на всіх аукціонах.
model AccessRule {
  id          String     @id @default(uuid()) @db.Uuid()
  kind        RuleKind
  value       String
  effect      RuleEffect @default(Forbid)
  isBuyAction Boolean    @default(false)
  auctionId   String?    @db.Uuid()
  auction     Auction?   @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  userGroupId String?    @db.Uuid()
  userGroup   UserGroup? @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  userId      String?    @db.Uuid()
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())

  @@index([auctionId])
  @@index([userGroupId])
  @@index([userId])
  @@map("access_rules")
}

enum ClientStage {
  New // новий запит
  Searching // підбір авто
  Negotiation // узгодження
  Purchased // куплено
  Delivered // доставлено
  Closed // закрито
}

// Клієнти (ТЗ 14): персональний облік замовників. User бачить своїх, GA - групи, SA - усіх.
model Client {
  id         String      @id @default(uuid()) @db.Uuid()
  ownerId    String      @db.Uuid()
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String?
  city       String?
  lookingFor String?     @db.Text
  stage      ClientStage @default(New)
  comments   String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([ownerId])
  @@map("clients")
}
