generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SuperAdmin
  Admin
  User
}

enum Rights {
  Read
  Write
  ReadAndWrite
  Buy
  Sell
  BuyAndSell
  All
}

model User {
  id            String         @id @default(uuid()) @db.Uuid()
  firstName     String
  lastName      String
  email         String         @unique
  password      String
  role          Roles          @default(User)
  rights        Rights         @default(Read)
  refreshTokens RefreshToken[]
  auctions      Auction[]      @relation("UserAuctions")
  session       Session?       @relation(fields: [sessionId], references: [id])
  sessionId     String?        @db.Uuid()

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid()
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model AuctionAuth {
  id       String @id @default(uuid()) @db.Uuid()
  email    String
  password String

  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id])

  sessions Session[]

  @@map("auction_auths")
}

model Session {
  id String @id @default(uuid()) @db.Uuid()

  maxConnections    Int
  activeConnections Int
  isActive          Boolean

  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id])

  auctionAuthId String      @db.Uuid
  account       AuctionAuth @relation(fields: [auctionAuthId], references: [id])

  users User[]

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model Auction {
  id             String        @id @default(uuid()) @db.Uuid()
  title          String
  url            String
  users          User[]        @relation("UserAuctions")
  sessions       Session[]
  auctionAuths   AuctionAuth[]
  auctionGroup   AuctionGroup? @relation(fields: [auctionGroupId], references: [id])
  auctionGroupId String?       @db.Uuid()

  @@map("auctions")
}

model AuctionGroup {
  id       String    @id @default(uuid()) @db.Uuid()
  title    String
  auctions Auction[]

  @@map("auction_groups")
}
