generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SuperAdmin
  Admin
  User
}

enum NotificationConfigType {
  Configurable
  System
}

enum Rights {
  Read
  Write
  All
}

enum SessionRights {
  Read
  Buy
  Sell
  All
}

enum NotificationChannel {
  InApp
  Email
  Telegram
  Viber
}

enum MaterialVisibility {
  All
  Group
}

enum SessionEventType {
  ForbiddenAction
  Navigation
  SessionError
  TextInput
  ButtonClick
  Other
}

enum LogSeverity {
  Info
  Warning
  Critical
}

model User {
  id                       String                    @id @default(uuid()) @db.Uuid()
  firstName                String
  lastName                 String
  email                    String                    @unique
  password                 String
  phone                    String?
  city                     String?
  telegramChatId           String?
  viberId                  String?
  role                     Roles                     @default(User)
  rights                   Rights                    @default(Read)
  sessionRights            SessionRights             @default(Read)
  isActive                 Boolean                   @default(true)
  isBlocked                Boolean                   @default(false)
  sessionLimit             Int                       @default(1)
  lastLogin                DateTime?
  lastActivity             DateTime?
  refreshTokens            RefreshToken[]
  auctions                 Auction[]                 @relation("UserAuctions")
  session                  Session?                  @relation(fields: [sessionId], references: [id])
  sessionId                String?                   @db.Uuid()
  resetTokens              ResetToken[]
  auctionGroup             AuctionGroup?             @relation("GroupParticipants", fields: [auctionGroupId], references: [id])
  auctionGroupId           String?                   @db.Uuid()
  managedGroup             AuctionGroup?             @relation("Administrator")
  userNotificationSettings UserNotificationSetting[]
  notifications            Notification[]
  trainingMaterials        TrainingMaterial[]
  terminatedSessions       Session[]                 @relation("SessionTerminator")
  sessionLogs              SessionLog[]
  accessibleGroupAccounts  AuctionGroup[]            @relation("GroupAccountAccess")
  selectedAccounts         AuctionAuth[]

  @@map("users")
}

model InformationPage {
  id        String   @id @default(uuid()) @db.Uuid()
  title     String
  slug      String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("information_pages")
}

model TrainingMaterial {
  id          String  @id @default(uuid()) @db.Uuid()
  title       String
  content     String  @db.Text
  imageUrl    String?
  isPublished Boolean @default(false)

  visibility   MaterialVisibility @default(All)
  allowedRoles Roles[]

  authorId String @db.Uuid()
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  groupId String?       @db.Uuid()
  group   AuctionGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("training_materials")
}

model NotificationType {
  id          String  @id @default(uuid()) @db.Uuid()
  name        String  @unique
  description String?

  roles Roles[]

  configType NotificationConfigType @default(Configurable)

  setting Json?

  userSettings      UserNotificationSetting[]
  groupRequirements GroupNotificationRequirement[]
}

model UserNotificationSetting {
  id                 String                @id @default(uuid()) @db.Uuid()
  userId             String                @db.Uuid()
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationTypeId String                @db.Uuid()
  notificationType   NotificationType      @relation(fields: [notificationTypeId], references: [id])
  value              Int
  isEnabled          Boolean               @default(true)
  channels           NotificationChannel[] @default([InApp])

  @@unique([userId, notificationTypeId])
  @@map("user_notification_settings")
}

model GroupNotificationRequirement {
  id                 String           @id @default(uuid()) @db.Uuid()
  groupId            String           @db.Uuid()
  group              AuctionGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  notificationTypeId String           @db.Uuid()
  notificationType   NotificationType @relation(fields: [notificationTypeId], references: [id])

  isMandatory Boolean @default(false)

  @@unique([groupId, notificationTypeId])
  @@map("group_notification_requirements")
}

model Notification {
  id     String @id @default(uuid()) @db.Uuid()
  userId String @db.Uuid()
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String
  message String  @db.Text
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@map("notifications")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid()
  token     String   @unique
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model AuctionAuth {
  id       String @id @default(uuid()) @db.Uuid()
  title    String
  email    String
  password String

  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  sessions Session[]
  user     User?     @relation(fields: [userId], references: [id])
  userId   String?   @db.Uuid()

  @@map("auction_auths")
}

model Session {
  id String @id @default(uuid()) @db.Uuid()

  maxConnections    Int
  activeConnections Int
  isActive          Boolean

  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id])

  auctionAuthId String      @db.Uuid
  account       AuctionAuth @relation(fields: [auctionAuthId], references: [id])

  users     User[]
  logs      SessionLog[]
  endedAt   DateTime?
  endedById String?      @db.Uuid()
  endedBy   User?        @relation("SessionTerminator", fields: [endedById], references: [id])

  expiresAt      DateTime
  createdAt      DateTime      @default(now())
  worker         Worker?       @relation(fields: [workerId], references: [id])
  workerId       String?       @db.Uuid()
  auctionGroup   AuctionGroup? @relation(fields: [auctionGroupId], references: [id])
  auctionGroupId String?       @db.Uuid()

  @@map("sessions")
}

model Auction {
  id                 String              @id @default(uuid()) @db.Uuid()
  title              String
  url                String
  users              User[]              @relation("UserAuctions")
  sessions           Session[]
  auctionAuths       AuctionAuth[]
  auctionGroup       AuctionGroup?       @relation(fields: [auctionGroupId], references: [id])
  auctionGroupId     String?             @db.Uuid()
  allowedRoutes      AllowedRoute[]
  forbiddenSelectors ForbiddenSelector[]
  forbiddenRoutes    ForbiddenRoute[]

  @@map("auctions")
}

model AuctionGroup {
  id    String @id @default(uuid()) @db.Uuid()
  title String

  isActive Boolean

  sessionLimit        Int     @default(0)
  canGaManageAccounts Boolean @default(false)
  showAccounts        Boolean @default(true)
  rules               Json?   @default("{}")
  accounts            User[]  @relation("GroupAccountAccess")

  auctions Auction[]
  sessions Session[]

  lastActivity DateTime?

  users                User[]   @relation("GroupParticipants")
  allowedProfileFields String[] @default(["firstName", "lastName", "phone", "city"])

  AdminId                       String?                        @unique @db.Uuid()
  Admin                         User?                          @relation("Administrator", fields: [AdminId], references: [id])
  groupNotificationRequirements GroupNotificationRequirement[]
  trainingMaterials             TrainingMaterial[]

  @@map("auction_groups")
}

model AllowedRoute {
  id        String  @id @default(uuid()) @db.Uuid()
  path      String
  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id])

  @@map("allowed_routes")
}

model ForbiddenRoute {
  id        String  @id @default(uuid()) @db.Uuid()
  path      String
  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id])

  @@map("forbidden_routes")
}

model ForbiddenSelector {
  id        String  @id @default(uuid()) @db.Uuid()
  selector  String
  auctionId String  @db.Uuid
  auction   Auction @relation(fields: [auctionId], references: [id])

  isBuyAction Boolean @default(false)

  @@map("forbidden_selectors")
}

model Worker {
  id       String    @id @default(uuid()) @db.Uuid()
  host     String
  port     Int
  isActive Boolean
  sessions Session[]
}

model ResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SessionLog {
  id        String  @id @default(uuid()) @db.Uuid()
  sessionId String  @db.Uuid()
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  userId String? @db.Uuid()
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  eventType SessionEventType
  severity  LogSeverity      @default(Info)

  message String @db.Text
  details Json?

  isIncident Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@index([isIncident])
  @@map("session_logs")
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid()
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}
