# ===== API (NestJS). Скопіюйте у .env поруч і заповніть. Значення нижче - приклади. =====

# PostgreSQL платформи
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/auctions_db
PORT=8000

# JWT (довгий випадковий рядок) і час життя access-токена
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m

# Шифрування паролів акаунтів аукціонів у базі (не змінювати після запуску - інакше паролі не розшифруються)
ENCRYPT_PASS=CHANGE_ME
ENCRYPT_SALT=CHANGE_ME

# Черга до browser-worker
RABBITMQ_URL=amqp://rabbitmq:5672

# Адреса фронтенду (посилання скидання пароля) і дозволені origin (через кому)
FRONTEND_URL=https://panel.caddyluck.com.ua
CORS_ORIGINS=https://panel.caddyluck.com.ua

# Капча на вході (Cloudflare Turnstile) - секретний ключ
TURNSTILE_SECRET_KEY=CHANGE_ME

# Email-сповіщення (SendGrid): API-ключ і адреса відправника
SENDGRID_API_KEY=CHANGE_ME
SENDGRID_CLIENT_ID=noreply@example.com

# Каталог для завантажених файлів (фото авто, зображення навчання)
UPLOADS_DIR=/app/uploads

# Часовий пояс для текстів нагадувань
TZ=Europe/Kyiv

# Бази CRM замовника (MySQL/MariaDB). Імена баз - за замовчуванням нижче.
CLIENT_DB_MAIN=caddylc2_caddycombca
CLIENT_DB_CRM=table_extourcars1
DB_CADDYLC2_CADDYCOMBCA_HOST=mysql-caddylc2
DB_CADDYLC2_CADDYCOMBCA_PORT=3306
DB_CADDYLC2_CADDYCOMBCA_USER=root
DB_CADDYLC2_CADDYCOMBCA_PASS=CHANGE_ME
DB_TABLE_EXTOURCARS1_HOST=mysql-client
DB_TABLE_EXTOURCARS1_PORT=3306
DB_TABLE_EXTOURCARS1_USER=root
DB_TABLE_EXTOURCARS1_PASS=CHANGE_ME
