# ---- Етап 1: Збірка (Builder) ----
FROM node:22-bullseye AS builder

WORKDIR /app

# Спочатку копіюємо лише package.json для кешування залежностей
COPY package*.json ./
RUN npm ci

# Копіюємо весь код проекту
COPY . .

# Якщо твій worker використовує Prisma (як API), розкоментуй наступний рядок:
# RUN npx prisma generate

# Збираємо саме browser-worker
RUN npm run build browser-worker

# ---- Етап 2: Продакшн (Runner) ----
FROM mcr.microsoft.com/playwright:v1.58.2-jammy

# Встановлюємо Node.js 22 в образ Playwright
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs

WORKDIR /app

# Встановлюємо ffmpeg
RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Встановлюємо ЛИШЕ продакшн-залежності (без nest-cli, typescript тощо)
COPY package*.json ./
RUN npm ci --production --ignore-scripts

# Копіюємо зібраний код з першого етапу (тільки dist!)
COPY --from=builder /app/dist ./dist

# Встановлюємо змінні середовища
ENV NODE_ENV=production
ENV DISPLAY=:99 

# Запускаємо скомпільований worker
CMD ["node", "dist/apps/browser-worker/main.js"]