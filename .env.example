# ===== docker compose + browser-worker. Скопіюйте у .env поруч і заповніть. =====

# Паролі баз для docker-compose.yml
DB_PASSWORD=CHANGE_ME
DB_TABLE_EXTOURCARS1_PASS=CHANGE_ME
DB_CADDYLC2_CADDYCOMBCA_PASS=CHANGE_ME

# WebRTC-трансляція
# Публічна IP-адреса сервера (воркер у Docker бачить лише внутрішню)
WEBRTC_ANNOUNCED_IP=203.0.113.10
# STUN/TURN (через кому). TURN потрібен для Firefox і мереж, де пряме з'єднання неможливе.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
WEBRTC_TURN_USERNAME=CHANGE_ME
WEBRTC_TURN_CREDENTIAL=CHANGE_ME

# Якість трансляції за замовчуванням (глобальні налаштування в панелі мають пріоритет)
STREAM_FPS=15
STREAM_JPEG_QUALITY=90
STREAM_BITRATE_KBPS=4000
